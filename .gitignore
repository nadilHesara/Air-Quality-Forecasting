# Data artefacts (large, regenerated by `python -m src.build_dataset`)
data/

# Trained model artefacts — ignore everything in models/ EXCEPT the canonical
# model.joblib, which is version-controlled. Note: you can't un-ignore a file
# inside an ignored directory, so we ignore the directory's *contents*
# (models/*) rather than the directory itself, then re-include model.joblib.
# The weekly retrain workflow commits the refreshed model.joblib (and
# reports/ + mlruns/) back to the repo.
models/*
!models/model.joblib

# MLflow local tracking store — NOT committed. The file store embeds absolute
# paths in meta.yaml at creation time, so a Windows-built mlruns/ breaks on
# Linux CI (and vice versa). Keep mlruns/ local-only; the workflow uploads it
# as a build artifact instead. To persist experiment history across machines,
# point MLFLOW_TRACKING_URI at a remote server (see README).
mlruns/

# Persistent local MLflow server backend (scripts/start_mlflow_server.*):
# the SQLite tracking/registry DB and its artifact store stay machine-local.
mlflow.db
mlflow-artifacts/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
