# Data artefacts (large, regenerated by `python -m src.build_dataset`)
data/

# Trained model artefacts — ignore everything in models/ EXCEPT the canonical
# model.joblib, which is version-controlled. Note: you can't un-ignore a file
# inside an ignored directory, so we ignore the directory's *contents*
# (models/*) rather than the directory itself, then re-include model.joblib.
# The weekly retrain workflow commits the refreshed model.joblib (and
# reports/ + mlruns/) back to the repo.
models/*
!models/model.joblib

# MLflow local tracking store is intentionally committed (experiment history),
# so it is NOT ignored here. To use a remote tracking server instead, set
# MLFLOW_TRACKING_URI (see README) — nothing local needs to change.

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
